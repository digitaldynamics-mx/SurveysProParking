---
interface Segment {
  label: string;
  value: number;
  color: string; // clase de Tailwind para el trazo, ej. "stroke-green-500"
  swatchClass: string; // clase de Tailwind para el punto de la leyenda, ej. "bg-green-500"
}

interface Props {
  segments: Segment[];
  centerValue: string;
  centerLabel: string;
}

const { segments, centerValue, centerLabel } = Astro.props;

const total = segments.reduce((sum, s) => sum + s.value, 0);
const r = 40;
const circumference = 2 * Math.PI * r;

let cumulative = 0;
const arcs = segments.map((s) => {
  const fraction = total > 0 ? s.value / total : 0;
  const length = fraction * circumference;
  const offset = -cumulative;
  cumulative += length;
  return { ...s, length, offset, pct: total > 0 ? Math.round(fraction * 100) : 0 };
});
---

<div class="flex items-center gap-5">
  <div class="relative h-28 w-28 shrink-0">
    <svg viewBox="0 0 100 100" class="h-full w-full -rotate-90">
      <circle cx="50" cy="50" r={r} fill="none" stroke-width="14" class="stroke-ink-700/8" />
      {total > 0 &&
        arcs.map((a) => (
          <circle
            cx="50"
            cy="50"
            r={r}
            fill="none"
            stroke-width="14"
            stroke-dasharray={`${Math.max(a.length - 1.5, 0)} ${circumference}`}
            stroke-dashoffset={a.offset}
            stroke-linecap="round"
            class={a.color}
          />
        ))}
    </svg>
    <div class="absolute inset-0 flex flex-col items-center justify-center">
      <span class="text-lg font-extrabold text-ink-800">{centerValue}</span>
      <span class="text-[10px] font-semibold text-ink-400">{centerLabel}</span>
    </div>
  </div>

  <ul class="space-y-1.5">
    {arcs.map((a) => (
      <li class="flex items-center gap-2 whitespace-nowrap text-xs text-ink-600">
        <span class={`h-2.5 w-2.5 shrink-0 rounded-full ${a.swatchClass}`}></span>
        <span class="font-semibold">{a.label}</span>
        <span class="text-ink-400">{a.value} · {a.pct}%</span>
      </li>
    ))}
  </ul>
</div>
