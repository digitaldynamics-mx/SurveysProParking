---
import Layout from '../../layouts/Layout.astro';
import QuestionRenderer from '../../components/QuestionRenderer.astro';
import SurveyFormScript from '../../components/SurveyFormScript.astro';
import { getSurveyBySlug } from '../../lib/surveys';

export const prerender = false;

const { slug } = Astro.params;
const survey = slug ? getSurveyBySlug(slug) : undefined;

if (!survey) {
  return Astro.redirect('/');
}
---

<Layout title={`${survey.title} — ProParking`}>
  <main class="px-5 py-16">
    <div class="mx-auto max-w-2xl">
      <span class="eyebrow">{survey.tag}</span>
      <h1 class="mt-4 text-3xl font-extrabold text-ink-800 sm:text-4xl">{survey.title}</h1>
      <p class="mt-3 text-ink-400">{survey.intro}</p>

      <form class="mt-10 space-y-5" data-survey-form data-survey-type={survey.type}>
        <fieldset class="rounded-2xl border border-ink-700/10 bg-white p-6 sm:p-7">
          <label for="nombre" class="px-1 text-base font-bold text-ink-800">Tu nombre</label>
          <input
            id="nombre"
            name="nombre"
            type="text"
            required
            placeholder="Nombre y apellido"
            class="mt-4 w-full rounded-xl border-2 border-ink-700/10 bg-cream-50 p-3 text-sm focus:border-orange-500 focus:outline-none"
          />
        </fieldset>

        {survey.questions.map((q, i) => (
          <QuestionRenderer question={q} index={i + 1} />
        ))}

        <p data-survey-error class="hidden rounded-xl bg-orange-50 p-4 text-sm text-orange-700">
          No se pudo enviar tu respuesta. Intenta de nuevo.
        </p>

        <button type="submit" class="btn-primary w-full">Enviar respuestas</button>
      </form>
    </div>
  </main>
  <SurveyFormScript />
</Layout>
